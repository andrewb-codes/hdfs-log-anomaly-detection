# FastAPI database connection for local test runs.
# Use host "localhost" here because pytest and local Alembic run on the host machine.
# Keep the same PostgreSQL user/password as .env, but use the host-published port.
DATABASE_URL=postgresql+asyncpg://anomaly_user:replace-with-db-password@localhost:5432/anomaly_test

# JWT secret used by the FastAPI authentication flow.
JWT_SECRET=test-jwt-secret

# Runtime environment and structured logging.
ENVIRONMENT=test

# Rate limiting key hashing.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_KEY_SECRET=test-rate-limit-secret

# CORS origins used by API tests.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
